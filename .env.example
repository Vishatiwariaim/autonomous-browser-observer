# Phase 1–4 / deploy
OBSERVER_HOST=127.0.0.1
OBSERVER_PORT=3847
OBSERVER_DATA_DIR=./data
OBSERVER_MAX_SCREENSHOT_BYTES=2097152
OBSERVER_LOG_LEVEL=info
